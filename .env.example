# Copy to .env.local (git-ignored). Nothing here is needed before stage 4 (users + sync).
#
# Supabase: the anon key is safe to ship to the client because Row Level Security
# protects every per-user table. NEVER put the service_role key anywhere in this repo.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
